# Dependencies (package-lock.json stays tracked)
node_modules/

# Local state, written by the tool on your machine
config.json
logs/
*.csv

# Your own ECU unlock number: never commit or share (unlock.example.json is the tracked placeholder)
unlock*.json
!unlock.example.json

# Other secrets, as a safety net
.env
.env.*
*.pem
*.key

# Editor and OS junk
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
# Tool and sync folders of the person working on it
.claude/
.stfolder/
.stignore
*.sync-conflict-*
*.log
npm-debug.log*

# Output of scripts/build-portable.js
dist/
